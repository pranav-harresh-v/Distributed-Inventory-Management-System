# Copy to .env and adjust for local development. .env is gitignored.
# Every setting below has a working default; nothing here is required.

# --- Storage ---------------------------------------------------------------
# Absolute or relative path to this node's SQLite file.
# Default: <repo>/data/node1.db
# Give each node its own file when running more than one; never share one.
#INVENTORY_DB_PATH=data/node1.db

# --- gRPC application server ----------------------------------------------
# Address the ClientService listens on. Default: 127.0.0.1:50051
#INVENTORY_GRPC_HOST=127.0.0.1
#INVENTORY_GRPC_PORT=50051

# Server thread-pool size. Default: 8
# Keep this at or below the SQLAlchemy connection budget (pool_size 5 +
# max_overflow 10 = 15) so a request never blocks waiting for a connection.
#INVENTORY_GRPC_MAX_WORKERS=8

# Root log level for the server process. Default: INFO
#INVENTORY_LOG_LEVEL=INFO

# --- Authentication --------------------------------------------------------
# How long an issued session token stays valid, in minutes. Default: 480 (8h)
#INVENTORY_SESSION_TTL_MINUTES=480

# --- LLM server ------------------------------------------------------------
# The LLM is a SEPARATE gRPC service. The application server calls it over
# gRPC only and never talks to Ollama itself; the LLM server never opens this
# node's SQLite database.

# Ollama runtime the LLM server generates against.
# Unprefixed on purpose: the official `ollama` package reads OLLAMA_HOST
# itself, so an INVENTORY_-prefixed copy would only shadow it.
#OLLAMA_HOST=http://127.0.0.1:11434

# Model tag to generate with. Default: phi3:mini
# Check with `ollama list`; run `ollama pull phi3:mini` if it is missing.
#OLLAMA_MODEL=phi3:mini

# Address the LLM service listens on, and that the application server dials.
# The port differs from the application server's 50051 so both can run on one
# machine during the demo.
#LLM_GRPC_HOST=127.0.0.1
#LLM_GRPC_PORT=50052

# How long to wait for one LLM answer, in seconds. Default: 60
# CPU-only Phi-3 generation is slow, and too low a value turns a working
# model into a failed request.
#LLM_REQUEST_TIMEOUT_SECONDS=60

# The LLM server reuses INVENTORY_LOG_LEVEL above rather than defining a
# second log-level setting.

# --- Development seed data -------------------------------------------------
# Password given to the demo admin by scripts/seed_data.py. Development only;
# it is bcrypt-hashed before storage and is never a production credential.
#SEED_ADMIN_PASSWORD=ChangeMe-Dev-Only-123
